{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "entrypoint": ".",
      "framework": "nextjs"
    },
    "insights": {
      "entrypoint": "insights_service/main.py",
      "framework": "fastapi",
      "memory": 2048,
      "maxDuration": 120,
      "includeFiles": [
        "insights_service/t20_insights.py",
        "insights_service/cricket_metrics.py",
        "insights_service/evaluator.py",
        "insights_service/outputs/**"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/_insights",
      "destination": {
        "service": "insights"
      }
    },
    {
      "source": "/_insights/:path*",
      "destination": {
        "service": "insights"
      }
    },
    {
      "source": "/:path*",
      "destination": {
        "service": "web"
      }
    }
  ]
}
